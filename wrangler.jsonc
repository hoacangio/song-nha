{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "song-nha",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLE", "class_name": "TableDO" },
      { "name": "HOST", "class_name": "HostDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableDO", "HostDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO"] }
  ],
  "vars": {
    // Extra allowed WebSocket origins, comma separated (same-origin is always allowed).
    "ALLOWED_ORIGINS": ""
  },
  "observability": { "enabled": true }
}
